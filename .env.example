# Copy to .env and fill in. Never commit .env or credential files (both are git- and railway-ignored).

# Default TEN Capital Investor List (used when none is uploaded). Alternatively place it at
# data/TEN_Capital_Investor_List.xlsx and leave this blank.
IM_INVESTOR_LIST_PATH=

IM_LOG_LEVEL=INFO

# Claude deck analysis — on whenever a key is set (deck text is sent to the Anthropic API).
# Create keys at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
IM_LLM_ENABLED=true
IM_LLM_MODEL=claude-opus-5-5

# Access password for the web app. Leave blank locally; always set it on a public deployment.
TEN_APP_PASSWORD=

# Automated results email (Resend) — on whenever RESEND_API_KEY is set. The FROM domain must be
# verified in Resend. Keys: https://resend.com/api-keys
RESEND_API_KEY=
IM_NOTIFY_ENABLED=true
IM_NOTIFY_TO=Info@tencapital.group
IM_NOTIFY_FROM=TEN Capital Investor Match <reports@tencapital.group>
IM_NOTIFY_REPLY_TO=
IM_PUBLIC_URL=

# Optional Google Sheets export: path to a service-account JSON key stored OUTSIDE this project.
IM_GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional: Drive folder shared with the service account, and addresses to share each sheet with
# (shared without a notification email).
IM_GOOGLE_DRIVE_FOLDER_ID=
IM_GOOGLE_SHARE_WITH=
